# Anthropic — the brain. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Google Sheet — the interaction log + cases.
# Leave GOOGLE_SHEET_ID blank to run on the in-memory store (works, nothing survives a restart).
# The log is also rewritten from Claude, which cannot append to a Sheet and so replaces the
# file — giving it a new id. The app falls back to finding it by name, so a swap is safe.
GOOGLE_SHEET_NAME=fo-01-log
GOOGLE_SHEET_ID=

# The OAuth client also signs viewers in, so each person reads their OWN Gmail and Chat.
# Add BOTH of these as Authorized redirect URIs on the client:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-deployment>/api/auth/google/callback
# Set the consent screen to Internal so anyone in the Workspace can sign in without
# Google's restricted-scope verification.
#
# Optional: SESSION_SECRET encrypts the session cookie. Derived from the client secret
# when unset; set it explicitly to rotate sessions without rotating OAuth.
SESSION_SECRET=

# Auth, option A: the OAuth client you already have.
#   1. Google Cloud console -> Credentials -> your OAuth client -> add Authorized redirect URI:
#      http://localhost:53682/callback
#   2. Enable the Google Sheets API for the project
#   3. npm run google:auth   (writes GOOGLE_REFRESH_TOKEN below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Auth, option B: a service account instead. Share the Sheet with this address as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Slack — bot token from OAuth install (xoxb-...). App-configuration tokens
# (xoxe.xoxp-...) only manage the app manifest and cannot read or post messages.
SLACK_BOT_TOKEN=
# The ONE channel this app may act in. Enforced in code, not just in the prompt.
SLACK_CHANNEL=ai-employee-fo-01-multi-channel-front-office-assistant
# Pin the id so the channel is never looked up. Without it the name is resolved by listing
# conversations, which reads metadata for every channel the bot can see.
SLACK_CHANNEL_ID=

# The ONE Google Chat space this app may act in. Enforced in code, like the Slack channel.
GCHAT_SPACE=spaces/AAQABsxe7jw
GCHAT_SPACE_LABEL=FO-01 Multi Channel Front Office Assistant
# Posting via an incoming webhook needs no configured Chat app and no OAuth, and is bound to
# the one space it was created in. In Google Chat: open the space -> Apps & integrations ->
# Webhooks -> Add webhooks -> name it -> copy the URL.
# Without this, posting falls back to the Chat API, which requires the Chat app to be
# configured on the Chat API's Configuration tab. Reading never needs either.
GCHAT_WEBHOOK_URL=

# Only used to build a helpful link when the Google Chat app is not configured.
GOOGLE_CLOUD_PROJECT=
